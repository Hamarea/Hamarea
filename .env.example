# ============================================================================
# Hamarea — variables d'environnement (fichier type)
#   • Dev local : copiez ce fichier →  cp .env.example .env.local  puis remplissez.
#   • Production : définissez les mêmes variables chez l'hébergeur (Vercel…).
#
# REQUIS pour que le site LISE/ÉCRIVE réellement en base : les 3 variables
# Supabase ci-dessous. Sans elles, le site tourne en « mode aperçu » (données
# simulées, AUCUNE écriture) — c'est normal tant qu'elles sont absentes.
# ============================================================================

# --- Supabase (REQUIS — persistance des données : produits, commandes, waitlist) ---
# Où : Dashboard → projet → Project Settings → API
#   https://supabase.com/dashboard/project/elyrrdpfzbnavqhqmirv/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://elyrrdpfzbnavqhqmirv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx     # clé « anon / public »
SUPABASE_SERVICE_ROLE_KEY=eyJxxx                     # clé « service_role » — SECRET, jamais exposée au navigateur

# --- Supabase — outillage CLI/MCP (PAS utilisé par l'app, sert aux migrations) ---
# Personal Access Token pour `supabase db push` / le serveur MCP (appliquer 0014…).
# À créer : https://supabase.com/dashboard/account/tokens   (format sbp_...)
# NB : donne accès à tout le compte → traiter comme un secret, révocable à tout moment.
SUPABASE_ACCESS_TOKEN=sbp_xxx

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000           # prod : https://hamarea-shop.com
NEXT_PUBLIC_SITE_NAME=Hamarea
# Emit AggregateRating/Review JSON-LD. Keep "false" until reviews are GENUINE
# and verifiable (Google manual-action + EU Omnibus risk on fabricated reviews).
NEXT_PUBLIC_ENABLE_REVIEW_SCHEMA=false

# --- Stripe (paiement) ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Resend / emails ---
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=no-reply@hamarea.com

# --- Shipping ---
SHIPPO_API_KEY=shippo_test_xxx

# --- Analytics & tracking (optional, all no-op until set) ---
# Browser tags load ONLY after the visitor consents (RGPD banner) AND the id is
# present. Server-side conversions (CAPI / TikTok) need the *_TOKEN secrets.
NEXT_PUBLIC_GA_ID=                 # e.g. G-XXXXXXX (GA4, Consent Mode v2)
NEXT_PUBLIC_META_PIXEL_ID=         # Meta/Facebook pixel id (browser + CAPI dedup)
META_PIXEL_ID=                     # server-only; falls back to NEXT_PUBLIC_META_PIXEL_ID
META_CAPI_TOKEN=                   # Meta Conversions API access token (server)
TIKTOK_PIXEL_CODE=                 # TikTok pixel code
TIKTOK_ACCESS_TOKEN=               # TikTok Events API access token (server)
